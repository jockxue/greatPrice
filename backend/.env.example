# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密码。
# 生产环境请直接通过系统环境变量 / 部署平台配置注入，不要依赖 .env 文件。

# 激活的配置：dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/great_price?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# 允许跨域访问的浏览器端来源（H5、管理后台），多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# 第一个管理员只在 admin_user 为空时创建。不要把真实密码提交到仓库。
# ADMIN_INIT_USERNAME=
# ADMIN_INIT_PASSWORD=

# 自动过期：默认开启，每 60 秒，每批 200 条
# DEAL_EXPIRY_ENABLED=true
# DEAL_EXPIRY_INTERVAL_MS=60000
# DEAL_EXPIRY_BATCH_SIZE=200

# 仅 prod：日志目录
LOG_PATH=./logs

# 淘宝联盟。不要把真实 App Secret、session 写进仓库。生产环境用系统环境变量注入。
# 接入前先在淘宝开放平台确认：应用已创建、已关联媒体备案、推广位 PID 已创建，
# 且 taobao.tbk.dg.material.optional、taobao.tbk.item.info.get、taobao.tbk.privilege.get 已授权。
# PID 形如 mm_{memberId}_{siteId}_{adzoneId}，siteId 是第二段，adzoneId 是第三段。
# TAOBAO_ENABLED=false
# TAOBAO_MANUAL_SYNC_ENABLED=false
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=
# TAOBAO_ADZONE_ID=
# TAOBAO_SITE_ID=
# TAOBAO_SESSION=
# 官方 HTTPS 地址见各 API 文档：https://eco.taobao.com/router/rest
# TAOBAO_GATEWAY_URL=https://eco.taobao.com/router/rest
# TAOBAO_CONNECT_TIMEOUT_MS=3000
# TAOBAO_READ_TIMEOUT_MS=8000
# TAOBAO_MAX_RETRIES=2
