# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密码。
# 生产环境请直接通过系统环境变量 / 部署平台配置注入，不要依赖 .env 文件。

# 激活的配置：dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/great_price?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# 允许跨域访问的浏览器端来源（H5、管理后台），多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# 第一个管理员只在 admin_user 为空时创建。不要把真实密码提交到仓库。
# ADMIN_INIT_USERNAME=
# ADMIN_INIT_PASSWORD=

# 仅 prod：日志目录
LOG_PATH=./logs

# 后续接入推广联盟时在此追加，例如：
# UNION_APP_KEY=
# UNION_APP_SECRET=
